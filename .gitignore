*~
/BUILD.sh
/data/
# Anchored: everything this repository builds now lands in /build/, and CI's own
# trees (build, build-tests, build-asan) are at the top of a fresh checkout too.
# An unanchored pattern also hides a stray build tree anywhere below, which is
# how four of them sat under test/ and test-consume/ for three months unnoticed.
/build*/
*.log
/doc/Fortran-*.pdf
/doc/mpi*-report.pdf
/bug-mpich-7916/mpich-abi-attr-bug
/bug-ompi-info-value/ompi-empty-info-value
/bug-ompi-object-names/ompi-object-names
/bug-ompi-aio-eagain/ompi-aio-eagain
/bug-ompi-aio-eagain/ompi-aio-eagain-probe
/bug-ompi-aio-eagain/posix-aio-limit
/bug-ompi-aio-eagain/*.dat
