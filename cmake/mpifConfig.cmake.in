@PACKAGE_INIT@

# libmpifort_abi deliberately links no MPI library (see "Choosing the MPI at
# run time" in CODE.md): the application is what links `mpi_abi`, per MPI-5.0
# section 20.2.1, and which MPI that is gets decided here, in the *consumer's*
# configure, not by whatever mpif happened to be built against. Attaching the
# ABI library to the imported target keeps one-line consumption working --
#     target_link_libraries(app PRIVATE mpif::mpifort_abi)
# -- where without it the executable would link, on macOS, and then die at
# its first MPI call, no libmpi_abi having been loaded to resolve the
# library's dynamic-lookup references.
#
# A plain find_library rather than find_dependency(MPI COMPONENTS C): FindMPI
# only answers for enabled languages, so it would force every pure-Fortran
# consumer to enable C -- and the one library the application may need to
# depend on directly is `mpi_abi` anyway. Honors an explicit
# MPI_mpi_abi_LIBRARY (FindMPI's spelling, which the test harnesses pin),
# then MPI_HOME, then the usual search including CMAKE_PREFIX_PATH.
if(NOT MPIF_MPI_ABI_LIBRARY)
  if(MPI_mpi_abi_LIBRARY)
    set(MPIF_MPI_ABI_LIBRARY "${MPI_mpi_abi_LIBRARY}"
      CACHE FILEPATH "The MPI ABI library that applications link")
  else()
    find_library(MPIF_MPI_ABI_LIBRARY
      NAMES mpi_abi
      HINTS ${MPI_HOME} ENV MPI_HOME
      PATH_SUFFIXES lib
      DOC "The MPI ABI library that applications link")
  endif()
endif()

# Report rather than abort. A package configuration file is allowed to fail:
# `find_package(mpif)` without REQUIRED -- QUIET or not -- must leave the
# consumer's configure running with mpif_FOUND false, which is what lets mpif
# be an optional dependency. message(FATAL_ERROR) here would end that
# consumer's configure instead. A REQUIRED caller loses nothing: CMake raises
# its own fatal error and prints this text back as the reason given by the
# package. Returning before mpifTargets.cmake is the other half -- an mpif that
# reports itself not found leaves no mpif::mpifort_abi behind, so a consumer
# cannot reach a target whose ABI library was never attached.
if(NOT MPIF_MPI_ABI_LIBRARY)
  # string(CONCAT) rather than set(): set() with several arguments makes a
  # list, and the message would come out semicolon-separated.
  string(CONCAT mpif_NOT_FOUND_MESSAGE
    "no MPI ABI library (libmpi_abi) found. Point "
    "CMAKE_PREFIX_PATH or MPI_HOME at an MPI implementing the standard ABI, "
    "or set MPIF_MPI_ABI_LIBRARY (or FindMPI's MPI_mpi_abi_LIBRARY) to the "
    "library itself.")
  set(mpif_FOUND FALSE)
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mpifTargets.cmake")

set_property(TARGET mpif::mpifort_abi APPEND PROPERTY
  INTERFACE_LINK_LIBRARIES "${MPIF_MPI_ABI_LIBRARY}")

# The Fortran compiler that built this mpif. Recorded because the installation
# is not compiler-neutral and nothing else says so: `mpi.mod` and `mpi_f08.mod`
# are that compiler's private format, so a consumer using another one gets its
# first `use mpi_f08` rejected, at its own source line and with nothing naming
# mpif or the real cause. Measured, flang 22 reading gfortran 15's modules:
# "Cannot parse module file for module 'mpi_f08': Unmatched '('", then "Bad
# character in Hollerith literal". The `.mod` files are only the
# first thing to break: whether a Fortran compiler passes a hidden character
# length, and as what type, is its own convention too, so an `include 'mpif.h'`
# consumer that gets past the modules is not thereby safe.
#
# These stay set whatever the verdict, so a consumer can ask rather than be
# told: `mpif_Fortran_COMPILER_ID`, `_VERSION` and the compiler itself.
set(mpif_Fortran_COMPILER_ID "@CMAKE_Fortran_COMPILER_ID@")
set(mpif_Fortran_COMPILER_VERSION "@CMAKE_Fortran_COMPILER_VERSION@")
set(mpif_Fortran_COMPILER "@CMAKE_Fortran_COMPILER@")

# Warn, not fail. A warning is what the case deserves: the comparison below is
# a proxy -- major versions are where the module format usually turns over, not
# where it is promised to -- and a consumer that only calls into the library
# through `mpif.h`, or one whose compilers are more compatible than their
# version numbers suggest, has a build that works. `MPIF_SKIP_COMPILER_CHECK`
# silences it for the consumer who knows which of those they are -- and it is
# the only thing that does: `find_package(mpif QUIET)` still gets the warning,
# QUIET being a request for silence about the *search*, which this is not a
# statement about.
#
# The condition is that the consumer's Fortran compiler is *known*, rather than
# that Fortran appears in ENABLED_LANGUAGES: those are the same thing for a
# project that called enable_language(Fortran), and asking this way also lets a
# project that has not -- a CMAKE_Fortran_COMPILER_ID passed on the command
# line -- state which compiler it will use and get the same answer.
# ci-scripts/check-package-config.sh tests both verdicts that way.
if(CMAKE_Fortran_COMPILER_ID AND NOT MPIF_SKIP_COMPILER_CHECK)
  set(_mpif_compiler_mismatch "")
  if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL mpif_Fortran_COMPILER_ID)
    set(_mpif_compiler_mismatch "a different Fortran compiler")
  else()
    # Major versions only. gfortran's module format turns over with the major
    # release and is stable within it, and LLVM's flang works the same way; a
    # minor-version comparison would warn on every 15.1-against-15.2 build,
    # which is the case that does work. Either version being unknown (a
    # compiler CMake could not extract one from) skips the comparison rather
    # than guessing.
    string(REGEX MATCH "^[0-9]+" _mpif_built_major
      "${mpif_Fortran_COMPILER_VERSION}")
    string(REGEX MATCH "^[0-9]+" _mpif_using_major
      "${CMAKE_Fortran_COMPILER_VERSION}")
    if(_mpif_built_major AND _mpif_using_major
        AND NOT _mpif_built_major STREQUAL _mpif_using_major)
      set(_mpif_compiler_mismatch "a different major version of the same compiler")
    endif()
  endif()
  if(_mpif_compiler_mismatch)
    string(CONCAT _mpif_compiler_warning
      "mpif was built with ${mpif_Fortran_COMPILER_ID} "
      "${mpif_Fortran_COMPILER_VERSION} (${mpif_Fortran_COMPILER}), and this "
      "project uses ${_mpif_compiler_mismatch}: ${CMAKE_Fortran_COMPILER_ID} "
      "${CMAKE_Fortran_COMPILER_VERSION} (${CMAKE_Fortran_COMPILER}). "
      "The installed mpi.mod and mpi_f08.mod are in the format of the compiler "
      "that wrote them, so `use mpi` and `use mpi_f08` will most likely fail to "
      "compile against this installation. Build mpif with this compiler, or "
      "point CMAKE_Fortran_COMPILER at the one above. Set "
      "MPIF_SKIP_COMPILER_CHECK to silence this.")
    message(WARNING "${_mpif_compiler_warning}")
    unset(_mpif_compiler_warning)
  endif()
  unset(_mpif_compiler_mismatch)
  unset(_mpif_built_major)
  unset(_mpif_using_major)
endif()

check_required_components(mpif)
